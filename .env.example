# Neon Postgres — copy both from the Neon dashboard for your project
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Stripe — Connect (split payments), Tax, Identity (KYC), and Klarna/BNPL all
# live under this one account. Dashboard > Developers > API keys (test mode).
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# Dashboard > Developers > Webhooks > add endpoint (or `stripe listen` locally)
STRIPE_WEBHOOK_SECRET=""
# App base URL, used to build Stripe redirect/return URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (Resend). The shared onboarding@resend.dev sender only delivers to the
# address that owns the API key — verify your own domain before real customers
# are expected to receive anything.
RESEND_API_KEY=""
EMAIL_FROM="EZBZ Marketplace <orders@yourdomain.com>"

# Where "you made a sale" notifications go for EZBZ-direct inventory (orders
# with no seller). Seller-fulfilled orders notify that seller's own account.
ORDER_NOTIFICATION_EMAIL=""
