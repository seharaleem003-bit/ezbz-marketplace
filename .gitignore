# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example carries no secrets and documents what a deploy needs.
!.env.example

# vercel
.vercel

# locally-uploaded listing photos (local-disk stopgap, see app/admin/listings/upload-actions.ts —
# won't exist once real object storage is wired in before deploy)
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev logs (can contain secrets, e.g. stripe-listen's webhook signing secret)
*.log

# The Vercel CLI appends its own .vercel / .env* rules on link; both are
# already covered above, and re-adding .env* here would undo the
# !.env.example exception.

# Scratch scripts and OneDrive conflict copies (never commit these —
# cands.json once held live Stripe key material).
.scratch/
cands.json
*-sehar.*
